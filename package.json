{
  "name": "nucarpool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "check:env": "node scripts/check-env-contract.js",
    "check:format": "prettier --check .",
    "check:routes": "node scripts/check-page-routes.js",
    "db:start": "docker-compose -f docker-compose.yml up -d",
    "db:stop": "docker-compose -f docker-compose.yml down",
    "db:schema": "prisma migrate dev && prisma generate",
    "seed": "yarn prisma db seed",
    "prepare": "husky",
    "test": "jest",
    "build:main": "prisma generate && next build",
    "startup": "yarn db:start && next dev",
    "build:development": "NODE_ENV=development prisma generate && next build",
    "build:production": "NODE_ENV=production prisma generate && next build"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-ses": "^3.1116.0",
    "@aws-sdk/credential-provider-env": "^3.972.70",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@headlessui/react": "^1.6.5",
    "@hookform/resolvers": "5.9.1",
    "@mapbox/polyline": "^1.2.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/x-date-pickers": "^5.0.7",
    "@next-auth/prisma-adapter": "^1.0.3",
    "@prisma/client": "^4.4.0",
    "@tanstack/react-query": "4.41.0",
    "@trpc/client": "^10.45.2",
    "@trpc/next": "^10.33.0",
    "@trpc/react-query": "^10.33.0",
    "@trpc/server": "^10.45.2",
    "@types/styled-components": "5.1.36",
    "antd": "5.27.4",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "dayjs": "1.11.23",
    "driver.js": "^1.8.0",
    "envsafe": "^2.0.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "mapbox-gl": "^3.28.1",
    "mixpanel-browser": "2.82.1",
    "next": "15.5.21",
    "next-auth": "4.24.15",
    "pusher": "^5.3.4",
    "pusher-js": "8.6.0",
    "rc-picker": "4.11.3",
    "rc-trigger": "^5.3.4",
    "react": "18.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "5.5.3",
    "react-hook-form": "7.86.0",
    "react-icons": "5.7.0",
    "react-toastify": "^9.0.4",
    "styled-components": "^6.5.3",
    "superjson": "^1.9.1",
    "tailwind-scrollbar": "^4.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@types/cropperjs": "^1.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/geojson": "7946.0.16",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/mapbox__polyline": "^1.0.2",
    "@types/mixpanel-browser": "2.66.0",
    "@types/node": "26.2.0",
    "@types/random-seed": "^0.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.0.5",
    "autoprefixer": "10.5.4",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-quick": "4.2.2",
    "prisma": "^4.14.1",
    "random-seed": "^0.3.0",
    "tailwindcss": "3.4.18",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "5.9.3"
  }
}
