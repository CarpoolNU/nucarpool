// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// This comment exists so the PR fixing the Auto Comment workflow
// matches its own `paths` filter and proves the reminder posts. It changes
// no models or fields, so it needs no PlanetScale deploy request.

// Specify the DB type and the connection string AKA DB_URL
datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Boilerplate--we would only change this if we wanted to change how 
// the Prisma Client is generated.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

// Represents a Role.
enum Role {
  RIDER
  DRIVER
  VIEWER
}

enum Permission {
  USER
  ADMIN
  MANAGER
}

// Represents a Status.
enum Status {
  ACTIVE
  INACTIVE
}

// Whether a carpool request is still awaiting an answer.
//
// Accepting a request used to leave the row untouched, so it stayed pending
// forever and the duplicate guard in `requests.create` blocked that pair from
// ever requesting each other again. There is no DECLINED member: declining
// deletes the row, which is the pre-existing behaviour.
enum RequestStatus {
  PENDING
  ACCEPTED
}

// Why a user reported another user (SCRUM-532). The reporter picks one; the
// free-text `Report.message` carries the detail. `OTHER` exists so a report
// never has to be forced into a category that does not fit.
enum ReportReason {
  SAFETY_CONCERN
  HARASSMENT
  INAPPROPRIATE_MESSAGES
  FAKE_PROFILE
  NO_SHOW
  OTHER
}

// Where a report stands in the admin queue. Every report is created `OPEN`,
// and nothing moves it yet: the queue is read-only until the suspension work
// (SCRUM-552) gives an admin something to resolve it with. `REVIEWED` and
// `DISMISSED` ship now so that ticket needs no second Deploy Request.
enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Represents an Account--need this for NextAuth.
model Account {
  id                String  @id @default(cuid()) // primary key
  userId            String  @map(name: "user_id") // foreign key
  type              String
  provider          String
  providerAccountId String  @map(name: "provider_account_id")
  refresh_token     String? @db.MediumText
  access_token      String? @db.MediumText
  expires_at        Int?
  ext_expires_in    Int?
  token_type        String?
  scope             String? @db.MediumText
  id_token          String? @db.MediumText
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "account")
}

// Represents a Session--need this for NextAuth
model Session {
  id           String   @id @default(cuid()) // primary key
  sessionToken String   @unique @map(name: "session_token")
  userId       String // foreign key
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "session")
}

// Represents an Invitation to a user
model Request {
  id                       String        @id @default(cuid()) // primary key
  message                  String        @db.VarChar(255)
  status                   RequestStatus @default(PENDING)
  fromUserId               String // foreign key
  toUserId                 String // foreign key
  fromUser                 User          @relation("sentRequests", fields: [fromUserId], references: [id])
  toUser                   User          @relation("receivedRequests", fields: [toUserId], references: [id])
  conversation             Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  dateCreated              DateTime      @default(now())
  conversationId           String?
  // Non-null while this request's email is owed: set by `requests.create` when
  // it creates or reopens the request, cleared when the email goes out. Null on
  // every row older than the column. See `sendRequestNotification`.
  notificationPendingSince DateTime?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([conversationId])
  @@map(name: "request")
}

// Represents a Conversation between two users
model Conversation {
  id          String    @id @default(cuid())
  requestId   String    @unique
  messages    Message[]
  request     Request[]
  dateCreated DateTime  @default(now())

  @@map(name: "conversation")
}

// Represents a Message sent by a User
model Message {
  id                  String       @id @default(cuid()) // Primary key
  conversationId      String // Foreign key
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content             String       @db.VarChar(255)
  isRead              Boolean      @default(false)
  User                User         @relation(fields: [userId], references: [id])
  userId              String
  dateCreated         DateTime     @default(now())
  // True while this message's email is owed: set by `sendMessage`, cleared when
  // the email goes out. See `sendMessageNotification`.
  notificationPending Boolean      @default(false)

  @@index([conversationId])
  @@index([userId])
  @@map(name: "message")
}

// Represents a group of users
model CarpoolGroup {
  id              String          @id @default(cuid()) // primary key
  dateCreated     DateTime        @default(now())
  carpoolSearches CarpoolSearch[]

  @@map(name: "group")
}

// Represents a User--need this for NextAuth and the data it stores.
model User {
  id                      String          @id @default(cuid()) // primary key
  name                    String?
  email                   String?         @unique
  emailVerified           DateTime?       @map(name: "email_verified")
  image                   String?         @db.MediumText
  bio                     String          @default("")
  preferredName           String          @default("")
  pronouns                String          @default("")
  accounts                Account[] // can have multiple accounts
  sessions                Session[] // can have multiple settings
  permission              Permission      @default(USER)
  isOnboarded             Boolean         @default(false) @map("is_onboarded")
  tutorialCompleted       Boolean         @default(false) @map("tutorial_completed")
  licenseSigned           Boolean         @default(false) @map("license_signed")
  // When the terms were accepted, and which wording was accepted. Written
  // together with `licenseSigned` by `user.acceptTerms`, which is their only
  // writer. See `src/utils/termsAcceptance.ts` for the version string and the
  // re-consent policy, and "Terms acceptance" in `src/server/db/README.md`.
  //
  // **Null on both is the legacy cohort**, not an error: every row predating
  // these columns accepted something at an unknown time, and some of those
  // rows only ever saved a profile. `licenseSigned` alone stays the record for
  // them, and it is not trustworthy. Their nullness is the signal that makes a
  // targeted re-consent possible, which is why the boolean was kept rather
  // than replaced.
  licenseSignedAt         DateTime?       @map("license_signed_at")
  licenseVersion          String?         @map("license_version") @db.VarChar(32)
  // When this user's profile picture was last uploaded, and null when they have
  // never uploaded one. Set by `user.recordProfilePictureUpload` after the
  // client's presigned PUT succeeds, since the PUT goes straight to S3 and the
  // server is not otherwise told.
  //
  // It exists so `getPresignedDownloadUrl` can answer "has a picture?" without
  // an S3 `HeadObject`, which was the entire AWS cost of rendering an avatar.
  // A timestamp rather than a boolean: it also records when the
  // picture last changed, and can serve as a cache-busting key later.
  //
  // It is the only record that a picture exists: null means "no picture", and
  // the download path signs nothing for it. Rows predating the column were
  // filled from S3 `LastModified` by a one-off backfill before that became true
  // (SCRUM-366).
  profilePictureUpdatedAt DateTime?       @map("profile_picture_updated_at")
  favoritedBy             User[]          @relation("Favorites")
  favorites               User[]          @relation("Favorites")
  sentRequests            Request[]       @relation("sentRequests")
  receivedRequests        Request[]       @relation("receivedRequests")
  message                 Message[]
  blocksMade              Block[]         @relation("blocksMade")
  blocksReceived          Block[]         @relation("blocksReceived")
  reportsMade             Report[]        @relation("reportsMade")
  reportsReceived         Report[]        @relation("reportsReceived")
  dateCreated             DateTime        @default(now())
  dateModified            DateTime        @default(now()) @updatedAt
  carpoolSearches         CarpoolSearch[]

  @@map(name: "user")
}

// Represents a Location on the map
model Location {
  id                     String          @id @default(cuid())
  city                   String          @default("") @map("city")
  state                  String          @default("") @map("state")
  street                 String          @default("") @map("street")
  streetAddress          String          @default("") @map("street_address")
  coordLng               Float           @default(0) @map("coord_lng")
  coordLat               Float           @default(0) @map("coord_lat")
  companyCarpoolSearches CarpoolSearch[] @relation("companyLocation")
  homeCarpoolSearches    CarpoolSearch[] @relation("homeLocation")
  dateCreated            DateTime        @default(now())
  dateModified           DateTime        @default(now()) @updatedAt

  // The candidate bounding box ranges on coord_lat and then narrows on
  // coord_lng, so latitude leads. There was no index on either
  // column before; the only ones on this table were implicit.
  @@index([coordLat, coordLng])
  @@map(name: "location")
}

model CarpoolSearch {
  id                     String        @id @default(cuid())
  userId                 String
  role                   Role          @default(VIEWER)
  companyName            String        @default("") @map("company_name")
  companyLocationId      String
  homeLocationId         String
  startTime              DateTime?     @map("start_time") @db.Time(0)
  endTime                DateTime?     @map("end_time") @db.Time(0)
  startDate              DateTime?     @map("start_date") @db.Date
  endDate                DateTime?     @map("end_date") @db.Date
  daysWorking            String        @default("") @map("days_working")
  seatsAvail             Int           @default(0) @map("seats_avail")
  status                 Status        @default(ACTIVE)
  carpoolId              String?
  // The driver's group ride preferences, previously a GROUP_DETAILS_V1: JSON
  // blob in `group_message` mirrored into `group.message`. Real columns, one
  // owner: the driver's own search. `groups.me` reads them through the group's
  // driver, so a driver sees the same values before and after having a group.
  //
  // Both legacy columns were dropped in SCRUM-287, once
  // `scripts/backfill-group-preferences.ts` had run in every environment. A
  // save writes all three together; null and "" both read as empty now that
  // there is no fallback for all-three-null to select.
  //
  // Widths match the limits the form and the Zod input enforce, so the database
  // is a backstop rather than the thing that silently truncates.
  groupNotes             String?       @map("group_notes") @db.VarChar(90)
  groupMusicPreference   String?       @map("group_music_preference") @db.VarChar(40)
  groupConversationStyle String?       @map("group_conversation_style") @db.VarChar(40)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyLocation        Location      @relation("companyLocation", fields: [companyLocationId], references: [id])
  homeLocation           Location      @relation("homeLocation", fields: [homeLocationId], references: [id])
  carpool                CarpoolGroup? @relation(fields: [carpoolId], references: [id])
  dateCreated            DateTime      @default(now()) @map("date_created")
  dateModified           DateTime      @default(now()) @updatedAt @map("date_modified")

  // One search per user, enforced rather than assumed. Every reader selects
  // "the" search with `findFirst` or `carpoolSearches[0]` and no `orderBy`, so
  // a second row would make those reads disagree with each other. Unlike the
  // relations, a unique index is real under `relationMode = "prisma"`: MySQL
  // enforces it. See docs/design/multi-carpool-search.md for why this is one
  // search and not many (SCRUM-543, SCRUM-544).
  //
  // `@@index([userId])` is now redundant with it and is kept for the moment:
  // dropping it is a separate decision with its own Deploy Request.
  @@unique([userId])
  @@index([userId])
  @@index([companyLocationId])
  @@index([homeLocationId])
  @@index([carpoolId])
  // The matching query filters status and role together. Neither is
  // selective alone -- two and three values -- but the pair is the whole
  // non-relational predicate, so this is the index that covers it.
  @@index([status, role])
  @@map("carpool_search")
}

// Records who performed an admin/manager mutation, on whom, and when.
// `actorId` and `targetId` are plain ids rather than relations: the point of
// an audit trail is to outlive the rows it describes, so it must not cascade
// when a `User` is deleted, and future admin mutations (SCRUM-541) may not
// target a `User` at all. Readers resolve ids to emails through
// `user.admin.getAllUsers`, the same list `UserManagement` already fetches.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  action      String
  targetId    String   @map("target_id")
  // JSON-serialized, action-specific detail (e.g. the permission a user was
  // changed to). `@db.Text` because this is server-constructed, not a
  // Zod-bounded user input, so `textLimits.ts`'s VARCHAR conventions don't
  // apply here.
  metadata    String?  @db.Text
  dateCreated DateTime @default(now()) @map("date_created")

  @@index([actorId])
  @@index([targetId])
  @@map("admin_audit_log")
}

// One user blocking another (SCRUM-532). A row is one direction, but the
// effect is symmetric: the server treats a pair as blocked if a row exists
// either way round, so neither user sees or reaches the other. Only the
// blocker can remove the row.
//
// Both relations cascade because a block means nothing without both users.
// That differs from `Report`, below, which must outlive them.
model Block {
  id          String   @id @default(cuid())
  blockerId   String   @map("blocker_id")
  blockedId   String   @map("blocked_id")
  blocker     User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  dateCreated DateTime @default(now()) @map("date_created")

  // The unique pair makes blocking idempotent and leads with `blockerId`, so
  // it also serves "who have I blocked". `blockedId` needs its own index for
  // the reverse lookup "who has blocked me", which every block check makes.
  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}

// A user's report about another user, read by admins (SCRUM-532).
//
// **A report must outlive what it describes.** Either party can delete the
// request a report was made from, and `requests.delete` takes the conversation
// and every message with it. So:
//   - `requestId` is a plain id, not a relation, as `AdminAuditLog` does and
//     for the same reason. It may point at nothing.
//   - `conversationSnapshot` is a server-built JSON copy of the thread's recent
//     messages, taken when the report is filed. That copy is the evidence.
//   - The two `User` relations declare no `onDelete`, so the emulated default
//     is `Restrict`: a user with reports cannot be deleted from under them,
//     matching `Request` and `Message`.
model Report {
  id                   String       @id @default(cuid())
  reporterId           String       @map("reporter_id")
  reportedUserId       String       @map("reported_user_id")
  reporter             User         @relation("reportsMade", fields: [reporterId], references: [id])
  reportedUser         User         @relation("reportsReceived", fields: [reportedUserId], references: [id])
  reason               ReportReason
  // The reporter's own words. Width matches `REPORT_MESSAGE_MAX_LENGTH`.
  message              String?      @db.VarChar(500)
  requestId            String?      @map("request_id")
  // `@db.Text` because the server builds it, not a Zod-bounded user input.
  conversationSnapshot String?      @map("conversation_snapshot") @db.Text
  status               ReportStatus @default(OPEN)
  dateCreated          DateTime     @default(now()) @map("date_created")
  dateModified         DateTime     @default(now()) @updatedAt @map("date_modified")

  @@index([reporterId])
  @@index([reportedUserId])
  // The admin queue lists reports newest first, and will filter by status
  // once reports can be resolved.
  @@index([status, dateCreated])
  @@map("report")
}

// Represents a VerificationToken--need this for NextAuth.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_token")
}
